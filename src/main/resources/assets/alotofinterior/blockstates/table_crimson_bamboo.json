            "apply": {
                "model": "alotofinterior:block/table_top_trim_north_bamboo"
            }
        },
        {
            "when": {
                "east": "false"
            },
            "apply": {
                "model": "alotofinterior:block/table_top_trim_east_bamboo"
            }
